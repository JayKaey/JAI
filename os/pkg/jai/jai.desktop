[Desktop Entry]
Type=Application
Name=J.A.I.
Comment=Local voice assistant
Comment[de]=Lokaler Sprachassistent
Exec=/usr/lib/jai/jai
Icon=jaios
Terminal=false
Categories=Utility;
# KWin gives Plasma's window list, pressed keys and screenshots only to the program whose
# entry asks for them, and finds the entry by the path in Exec (`installer::menu_entry`).
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management,org_kde_kwin_fake_input
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
