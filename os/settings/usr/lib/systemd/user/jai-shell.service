# J.A.I.OS's desktop shell: the taskbar, the [J] menu, the desktop and the notifications, drawn
# by J.A.I. on KWin in place of plasmashell. A crash starts it again; the third within a minute
# leaves it failed, and KDE's own desktop opens as safe mode (jai-safe-desktop.service).
[Unit]
Description=J.A.I.OS desktop shell
PartOf=graphical-session.target
After=plasma-kwin_wayland.service plasma-kcminit.service
StartLimitBurst=3
StartLimitIntervalSec=60
OnFailure=jai-safe-desktop.service

[Service]
ExecStart=/usr/lib/jai/jai --shell
# (His settings file is read from here; the shell also runs before the folder exists.)
WorkingDirectory=-%h/.local/share/jai
Restart=on-failure
RestartSec=1
Slice=session.slice
TimeoutStopSec=5

[Install]
WantedBy=plasma-workspace.target
