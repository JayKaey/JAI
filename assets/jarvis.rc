// Windows resources for JARVIS.exe (compiled by build.rs).

1 ICON "jarvis_icon.ico"

// RT_MANIFEST (24), id 1 = the executable's application manifest.
1 24 "jarvis.manifest"

1 VERSIONINFO
FILEVERSION 3,1,0,0
PRODUCTVERSION 3,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "J.A.I."
