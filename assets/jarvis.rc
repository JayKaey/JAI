            VALUE "InternalName", "jarvis"
            VALUE "OriginalFilename", "JARVIS.exe"
            VALUE "ProductName", "J.A.I. local voice assistant"
            VALUE "ProductVersion", "3.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
